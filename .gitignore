# Dependencies
node_modules/

# Build output
dist/
.next/

# Test and coverage output
coverage/

# Generated by `next build`/`next dev`; regenerated on demand, never edited.
next-env.d.ts

# Tool caches
.eslintcache
*.tsbuildinfo

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code: personal overrides stay local, shared config is tracked
.claude/settings.local.json
# Claude Code: agent worktrees are full checkouts, never part of this one
.claude/worktrees/

# Environment variables (example files are tracked on purpose)
.env
.env.*
.envrc
!.env.example
!.env.sample
!.env.template

# Credentials kept in a checkout: never tracked, and never read by a tool here
secrets/

# Logs
*.log

# OS
.DS_Store
Thumbs.db
