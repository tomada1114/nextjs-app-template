{
  "name": "my-package",
  "version": "0.1.1",
  "description": "A short description.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs .next coverage .eslintcache tsconfig.tsbuildinfo",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest related --run",
    "agents:sync": "node scripts/sync-agents.mjs",
    "agents:check": "node scripts/sync-agents.mjs --check",
    "repo:labels": "node scripts/sync-labels.mjs",
    "check:staged": "node scripts/check-staged.mjs",
    "check:quick": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:source": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:coverage",
    "fix": "eslint . --fix && prettier --write .",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.12",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  }
}
