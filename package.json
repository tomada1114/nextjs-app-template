{
  "name": "my-package",
  "version": "0.1.1",
  "description": "A short description.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.2.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs .next coverage .eslintcache tsconfig.tsbuildinfo",
    "clean:deep": "node scripts/clean.mjs .next coverage .eslintcache tsconfig.tsbuildinfo dist node_modules",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project='!smoke'",
    "test:watch": "vitest --project='!smoke'",
    "test:coverage": "vitest run --coverage --project='!smoke'",
    "test:smoke": "vitest run --project=smoke",
    "test:related": "vitest related --run --project='!smoke'",
    "agents:sync": "node scripts/sync-agents.mjs",
    "agents:check": "node scripts/sync-agents.mjs --check",
    "repo:labels": "node scripts/sync-labels.mjs",
    "check:staged": "node scripts/check-staged.mjs",
    "check:quick": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:source": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:smoke && pnpm run test:coverage",
    "fix": "eslint . --fix && prettier --write .",
    "prepare": "node scripts/verify-hooks.mjs",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.14",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
