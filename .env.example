# Copy this file to .env and fill in what you need. Every name below is
# declared in src/server/env.ts, which is the only place this application
# reads process.env; tests/server-env.test.ts fails when the two drift apart.

# Credential for OpenRouter, the provider every answer comes from by default.
# Required: POST /api/ask refuses to load without it unless LLM_ADAPTER=fake.
# Create one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# The OpenRouter model id to answer with, e.g. deepseek/deepseek-v4.1-flash.
# Optional: left blank, the adapter's own default model answers.
LLM_MODEL=

# Set to `fake` -- the only accepted value -- to answer from the fake adapter:
# no key is required and nothing is billed. Meant for tests and a keyless local
# run. Never set implicitly; a missing OPENROUTER_API_KEY fails the route
# rather than falling back to it.
LLM_ADAPTER=

# Shared secret a caller of POST /api/ask must send as `Authorization: Bearer
# <value>`. Required beside OPENROUTER_API_KEY, because every answer through
# the provider is billed: readServerEnv refuses to serve the endpoint open.
# Optional only under LLM_ADAPTER=fake. It buys authentication only:
# this template ships no rate limit.
API_ACCESS_KEY=
